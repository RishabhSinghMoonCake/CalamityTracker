PORT=8000
MONGODB_KEY=mongodb://127.0.0.1:27017/calamitytracker
REDIS_URL=redis://127.0.0.1:6379

# Ingestion Settings
NEWS_API_URL=https://newsdata.io/api/1/latest
NEWS_API_KEY=replace_me

# Groq Routing & Resilience. Do not include mock in production fallbacks.
AI_PRIMARY_PROVIDER=groq-primary
AI_FALLBACK_PROVIDERS=groq-fallback-1
GROQ_API_KEY=replace_me
GROQ_API_KEY_FALLBACK_1=replace_me
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
AI_PROMPT_VERSION=v3
AI_MAX_ATTEMPTS=3
AI_BATCH_SIZE=3
AI_DAILY_REQUEST_BUDGET=50
AI_RATE_LIMIT_COOLDOWN_SECONDS=60
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=500

# Required in production for all /api/admin/* endpoints
ADMIN_API_KEY=replace_me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Geocoding Service (Nominatim OSM)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=CalamityTracker/1.0 (your-email@example.com)

# Incident Caching
INCIDENTS_CACHE_TTL_SECONDS=60

# BullMQ Pipeline Automation
PIPELINE_AUTOMATION_ENABLED=false
NEWS_INGESTION_CRON=0 */6 * * *
NEWS_BOOTSTRAP_ENABLED=true
NEWS_MAX_QUERIES_PER_RUN=5
NEWS_QUERY_ROTATION_MINUTES=360
NEWS_REQUEST_TIMEOUT_MS=30000
NEWS_REQUEST_RETRIES=1
NEWS_REQUEST_DELAY_MS=5000
NEWS_RETRY_DELAY_MS=5000
AI_PROCESSING_CRON=*/5 * * * *

# Community Reporting & Corroboration
COMMUNITY_CLUSTER_RADIUS_METERS=5000
COMMUNITY_CLUSTER_WINDOW_HOURS=24
COMMUNITY_CONFIRMATION_THRESHOLD=3
COMMUNITY_REPORT_RATE_LIMIT=10
COMMUNITY_REPORT_RATE_WINDOW_SECONDS=3600
